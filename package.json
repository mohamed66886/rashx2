{
  "name": "rashx",
  "private": true,
  "scripts": {
    "build": "HOME=/tmp turbo run build",
    "dev": "HOME=/tmp turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@rashx/web",
    "dev:app": "turbo run dev --filter=@rashx/app",
    "dev:tenant": "turbo run dev --filter=@rashx/tenant",
    "dev:admin": "turbo run dev --filter=@rashx/admin",
    "lint": "HOME=/tmp turbo run lint",
    "typecheck": "HOME=/tmp turbo run typecheck",
    "test": "HOME=/tmp turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\" --ignore-path .gitignore",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.9.1"
}
